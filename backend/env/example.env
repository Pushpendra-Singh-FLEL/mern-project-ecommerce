// application configuration file
PORT=Application port number
DNS_SERVERS=DNS servers for network configuration (comma-separated)

// deployment configuration
NODE_ENV=Node.js environment (development, production, etc.)

// MongoDB connection URI, Retry settings
MONGO_URI=MongoDB connection URI
RETRIES=Number of retry attempts
RETRY_DELAY=Delay between retry attempts (in milliseconds)

// JWT and Cookie settings
JWT_SECRET=JWT secret key
NODE_ENV=Node.js environment (development, production, etc.)
SALT_ROUNDS=Number of salt rounds for password hashing
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=JWT token expiration time (e.g., "1h", "7d")
COOKIE_SECRET=your_cookie_secret
COOKIE_EXPIRES_IN=Cookie expiration time (e.g., "1h", "7d")